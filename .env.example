# ==============================================================================
# Food Thunder Deli - Server Environment Configuration Template
# Copy this file to .env before starting: cp .env.example .env
# ==============================================================================

# Port Configurations
MYSQL_PORT=3306
CLIENT_PORT=80

# Database Credentials
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=grabfood_db

# Client API URL configuration:
# - Use '/api/v1' when serving both Client and API behind Nginx on the same domain/IP (Recommended)
# - Or use full URL like 'http://YOUR_SERVER_IP:8080/api/v1' if direct port 8080 is preferred
VITE_API_BASE_URL=/api/v1

# Security / JWT Secret (Must match across API Gateway and Auth Service)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

